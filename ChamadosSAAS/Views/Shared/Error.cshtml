@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<main class="error-page" id="conteudo" tabindex="-1">
    <div class="error-card">
        <p class="brand">
            <span class="logo-mark" aria-hidden="true"></span>
            Chamados
        </p>
        <h1>Algo saiu do rumo.</h1>
        <p>Não foi possível concluir esta requisição. Tente novamente em instantes.</p>
        @if (Model.ShowRequestId)
        {
            <p class="request-id">ID da requisição: <code translate="no">@Model.RequestId</code></p>
        }
        <a class="btn-enter btn-enter--inline" asp-controller="Account" asp-action="Login">Voltar ao login</a>
    </div>
</main>
