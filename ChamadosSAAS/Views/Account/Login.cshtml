@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="auth-shell">
    <section class="auth-showcase" aria-labelledby="showcase-title">
        <div class="showcase-glow" aria-hidden="true"></div>
        <header class="showcase-brand">
            <span class="logo-mark" aria-hidden="true"></span>
            Chamados
        </header>

        <div class="showcase-copy">
            <p class="eyebrow">Helpdesk para times enxutos</p>
            <p class="showcase-title" id="showcase-title">Onde cada chamado encontra um dono.</p>
            <p class="lede">Abra, priorize e acompanhe solicitações em um único lugar — sem planilha, sem fio partido.</p>
        </div>

        <div class="ticket-stack" aria-hidden="true">
            <article class="ticket-card ticket-card--back">
                <span class="ticket-id">#1041</span>
                <strong>Acesso ao VPN instável</strong>
                <span class="ticket-meta">Rede · Alta</span>
            </article>
            <article class="ticket-card ticket-card--mid">
                <span class="ticket-id">#1042</span>
                <strong>Nota fiscal não emitida</strong>
                <span class="ticket-meta">Financeiro · Média</span>
            </article>
            <article class="ticket-card ticket-card--front">
                <div class="ticket-top">
                    <span class="ticket-id">#1043</span>
                    <span class="status-pill">Em andamento</span>
                </div>
                <strong>Impressora do 2º andar parou</strong>
                <p>A fila da recepção está parada desde as 14h.</p>
                <span class="ticket-meta">Infra · Atribuído a Ana</span>
            </article>
        </div>
    </section>

    <main class="auth-panel" id="conteudo" tabindex="-1">
        <div class="auth-card">
            <header class="auth-heading">
                <p class="mobile-brand">
                    <span class="logo-mark" aria-hidden="true"></span>
                    Chamados
                </p>
                <h1>Entrar na conta</h1>
                <p>Use o e-mail da sua equipe para continuar.</p>
            </header>

            <form asp-controller="Account" asp-action="Login" method="post" class="login-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="form-summary" role="alert"></div>
                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <p class="form-status" role="status" tabindex="-1">@Model.StatusMessage</p>
                }

                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email"
                           autocomplete="username"
                           autocapitalize="none"
                           spellcheck="false"
                           placeholder="voce@empresa.com"
                           aria-required="true"
                           aria-describedby="Email-error" />
                    <span asp-validation-for="Email" class="field-error" id="Email-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Senha"></label>
                    <div class="password-wrap">
                        <input asp-for="Senha"
                               autocomplete="current-password"
                               autocapitalize="off"
                               spellcheck="false"
                               aria-required="true"
                               aria-describedby="Senha-error" />
                        <button type="button"
                                class="password-toggle"
                                data-password-toggle
                                aria-controls="Senha"
                                aria-pressed="false"
                                aria-label="Mostrar senha">Mostrar</button>
                    </div>
                    <span asp-validation-for="Senha" class="field-error" id="Senha-error"></span>
                </div>

                <div class="form-row">
                    <label class="remember" asp-for="LembrarMe">
                        <input asp-for="LembrarMe" />
                        <span>@Html.DisplayNameFor(m => m.LembrarMe)</span>
                    </label>
                </div>

                <button type="submit" class="btn-enter">Entrar</button>
            </form>

            <p class="auth-footnote">Protótipo de interface. A autenticação ainda não está conectada.</p>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
